{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2024"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "@cloudflare/vitest-pool-workers/types"
    ],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "workers/app/**/*.ts",
    "packages/**/*.ts",
    "tests/integration/**/*.ts",
    "vitest.config.ts"
  ]
}
